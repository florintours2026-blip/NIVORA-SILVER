rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() && userDoc().exists() ? userDoc().data.role : null; }
    function admin() { return signedIn() && (role() == 'admin' || role() == 'manager'); }
    function employee() { return signedIn() && (role() == 'employee' || role() == 'admin' || role() == 'manager'); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if owner(uid) && request.resource.data.role == 'customer';
      allow read: if owner(uid) || admin();
      allow update: if admin() || (owner(uid) && request.resource.data.role == resource.data.role);
      allow delete: if admin();
    }

    match /offers/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if admin();
      allow delete: if admin();
    }

    match /transactions/{id} { allow read, write: if admin(); }
    match /expenses/{id} { allow read, write: if admin(); }
    match /refunds/{id} { allow read, write: if admin(); }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
  }
}
