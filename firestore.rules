rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'manager');
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    // Existing NIVORA admin structure: admins/{Firebase Auth UID} with role=admin/manager.
    // Admin records are managed from Firebase Console; the public site cannot create or edit them.
    match /admins/{uid} {
      allow read: if owner(uid);
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow create: if owner(uid) && request.resource.data.role == 'customer';
      allow read: if owner(uid) || admin();
      allow update: if owner(uid) || admin();
      allow delete: if admin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if admin();
      allow delete: if admin();
    }

    match /transactions/{id} {
      allow read, write: if admin();
    }

    match /expenses/{id} {
      allow read, write: if admin();
    }

    match /refunds/{id} {
      allow read, write: if admin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
