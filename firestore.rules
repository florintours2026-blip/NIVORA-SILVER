rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'admin'); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if owner(uid);
      allow read: if owner(uid) || admin();
      allow update: if owner(uid) || admin();
      allow delete: if admin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if admin();
      allow delete: if admin();
    }

    match /transactions/{id} {
      allow read, write: if admin();
    }

    match /expenses/{id} {
      allow read, write: if admin();
    }

    match /refunds/{id} {
      allow read, write: if admin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
