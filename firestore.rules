rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null; }
    function admin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'admin' || role() == 'admin'); }
    function staff() { return signedIn() && (admin() || role() in ['employee','manager']); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if owner(uid) && request.resource.data.role == 'customer';
      allow read: if owner(uid) || admin();
      allow update: if admin() || (owner(uid) && request.resource.data.role == resource.data.role);
      allow delete: if admin();
    }
    match /products/{id} { allow read: if true; allow create, update, delete: if admin(); }
    match /offers/{id} { allow read: if true; allow create, update, delete: if admin(); }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if staff() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if staff();
      allow delete: if admin();
    }
    match /transactions/{id} { allow read, write: if admin(); }
    match /expenses/{id} { allow read, write: if admin(); }
    match /refunds/{id} { allow read, write: if admin(); }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
  }
}
