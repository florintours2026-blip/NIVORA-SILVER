rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownAdminRecord() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function adminRecord() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return ownAdminRecord() && adminRecord().role in ['admin', 'manager'];
    }
    function isStaff() {
      return ownAdminRecord() && adminRecord().role in ['admin', 'manager', 'employee'];
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /admins/{uid} {
      // A signed-in account can read only its own role document.
      // Clients cannot create/change admin roles from the browser.
      allow read: if owner(uid);
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow create: if owner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'customer';
      allow read: if owner(uid) || isStaff();
      allow update: if owner(uid) || isStaff();
      allow delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if isStaff() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read, write: if isAdmin();
    }

    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    match /refunds/{id} {
      allow read, write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
