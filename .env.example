NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://YOUR-GITHUB-USERNAME.github.io
STORE_CURRENCY=EGP
STORE_LOCALE=ar-EG
# Firebase Web API key (same public project key used by the web app; stored server-side here for token verification)
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
# Comma-separated verified Firebase admin emails allowed to use URL importing
IMPORT_ADMIN_EMAILS=admin@example.com
IMPORT_TIMEOUT_MS=15000
MAX_IMPORT_REQUESTS_PER_MINUTE=10
# Legacy SMTP/Postgres values are optional and are not required for Firebase catalog/import MVP.
DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
